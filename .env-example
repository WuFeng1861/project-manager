# Database Configuration
DB_DATABASE=project_manager.sqlite
DB_SYNCHRONIZE=true

# ============================================================
# 管理员账号
# ============================================================
# 注意：现在不再使用 SERVER_PASSWORD。
# 管理员账号密码在「首次打开网页」时设置，密码经 scrypt 加盐哈希后写入 SQLite，
# 后台可随时修改账号/密码。下面的 SERVER_PASSWORD 仅为兼容旧配置保留，已不生效。
# SERVER_PASSWORD=xxxx

# 管理员登录会话有效期（小时，默认 168 = 7 天）
# ADMIN_SESSION_TTL_HOURS=168

# 可选：限制「首次初始化」只允许来自指定 IP（逗号分隔）。
# 留空表示不限制——谁先打开网页谁就能完成初始化，请部署后第一时间完成设置。
# SETUP_ALLOWED_IPS=203.0.113.9

# ============================================================
# 项目上报白名单
# ============================================================
# 只有白名单里的 IP 才能调用 POST /projects；
# 非白名单 IP 会被拦截，并自动加入黑名单（原因：非项目成员）。
# true（默认）= 开启校验；false = 临时关闭（灰度/排障用）
# UPLOAD_WHITELIST_ENFORCE=true

# 被拦截 IP 的拉黑时长（毫秒，默认 30 天）
# UPLOAD_BLOCK_MS=2592000000

# 首次启动时额外播种的白名单 IP（逗号分隔，除 127.0.0.1 之外）
# IP_WHITELIST=203.0.113.9,198.51.100.7

# 首次播种时是否自动把现有 project 表里的上报来源 IP 也加进白名单（默认 true）
# 白名单开启后未在名单内的机器会被拦死，所以默认开启历史回填，避免上线即失联
# WHITELIST_SEED_FROM_PROJECTS=true

# ============================================================
# 反向代理
# ============================================================
# 不填: 自动信任本机与内网代理（支持多层）
# 可选: true / false / 代理层数 / IP或CIDR列表（逗号分隔）
# TRUST_PROXY=1

# ============================================================
# 频率限制
# ============================================================
# 正常请求上限（每个 IP 在每个窗口内的请求数，默认 30）
# RATE_LIMIT_NORMAL_MAX=30
# 统计窗口（毫秒，默认 60000）
# RATE_LIMIT_WINDOW_MS=60000
# 超过正常上限的倍数后拉黑（默认 10，即 30 × 10 = 300 次/分钟）
# RATE_LIMIT_BLACKLIST_MULTIPLIER=10
# 黑名单时长（毫秒，默认 24 小时）
# RATE_LIMIT_BLOCK_MS=86400000
