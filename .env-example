# Database Configuration
DB_DATABASE=project_manager.sqlite
DB_SYNCHRONIZE=true

# Application Configuration
PORT=3000
SERVER_PASSWORD=xxxx

# Proxy Configuration
# 不填: 自动信任本机与内网代理（支持多层）
# 可选: true / false / 代理层数 / IP或CIDR列表（逗号分隔）
# TRUST_PROXY=1

# Rate Limit Configuration
# 正常请求上限（每个 IP 在每个窗口内的请求数，默认 30）
# RATE_LIMIT_NORMAL_MAX=30
# 统计窗口（毫秒，默认 60000）
# RATE_LIMIT_WINDOW_MS=60000
# 超过正常上限的倍数后拉黑（默认 10，即 30 × 10 = 300 次/分钟）
# RATE_LIMIT_BLACKLIST_MULTIPLIER=10
# 黑名单时长（毫秒，默认 24 小时）
# RATE_LIMIT_BLOCK_MS=86400000
